{
  "name": "obsidian-folder-encrypt",
  "version": "0.1.1",
  "description": "Obsidian plugin: encrypt notes incl. file names, or whole folders",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node tests/run-tests.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "encryption",
    "meld-encrypt"
  ],
  "author": "archiwzzard",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.6",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  }
}
