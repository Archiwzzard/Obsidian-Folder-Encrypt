{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2020",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"importHelpers": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["DOM", "ES2020", "ES2021"]
	},
	"include": ["src/**/*.ts"]
}
